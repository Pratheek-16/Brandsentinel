# Example environment configuration
# Copy to .env and fill in real values where needed
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=
LLM_MODEL=
# Database URL
# Local development:
DATABASE_URL=sqlite:///./brandsentinel.db
# Supabase/PostgreSQL example (URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<url-encoded-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# JWT settings (example only)
JWT_SECRET_KEY=replace_me_with_a_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Feature flags
SEED_DEMO=false
